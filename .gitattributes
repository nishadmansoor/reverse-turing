# fp32 training outputs
models/bert_classifier/** filter=lfs diff=lfs merge=lfs -text
models/cnn_classifier.pt filter=lfs diff=lfs merge=lfs -text

# int8 graphs the deployed app serves. Binary and re-exported whenever the
# models are retrained, so they belong in LFS rather than git history.
models/onnx/*.onnx filter=lfs diff=lfs merge=lfs -text

